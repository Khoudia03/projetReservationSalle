<?php

declare(strict_types=1);

require __DIR__ . '/vendor/autoload.php';

use App\Migration\Migrate;

$commande = $argv[1] ?? null;

if ($commande === null) {
    echo "Veuillez préciser une commande." . PHP_EOL;
    echo "Exemple : php khoudia execute" . PHP_EOL;
    exit(1);
}

$demarrerEloquent = require __DIR__ . '/config/eloquent.php';

$capsule = $demarrerEloquent();

$migrate = new Migrate($capsule);

switch ($commande) {

    case 'execute':
        $migrate->execute();
        break;

    default:
        echo "Commande inconnue : {$commande}" . PHP_EOL;
        exit(1);
}
